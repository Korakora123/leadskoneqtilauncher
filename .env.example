# Koneqti Leads launcher configuration
# Copy to .env (dev) or to <userData>/.env (installed app).
BRAIN_WS_URL=ws://[WINDOWS_VPS_IP]:4100/ws
BRAIN_HTTP_URL=http://[WINDOWS_VPS_IP]:4100
ELECTRON_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DASHBOARD_URL=https://leads.koneqti.com

# Optional
# JOB_CONCURRENCY=1          # 1-2 parallel browser jobs overall
# KONEQTI_HEADLESS=0         # 1 = run browsers headless (testing only)
# CHROME_PATH=               # override local Chrome executable path
